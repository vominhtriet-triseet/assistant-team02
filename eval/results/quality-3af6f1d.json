 "bugs": {
  "bugs": [
   {
    "id": "BUG-01",
    "title": "Busy days after the first one in a list are ignored",
    "severity": "High",
    "found": "Evaluation scenario C04",
    "before": "9ad5025",
    "after": "HEAD",
    "steps": "Send: \"Essay due Wednesday, 2 hours. 2 hours on weekdays. Busy on Monday, Tuesday and Wednesday.\"",
    "expected": "Mon, Tue and Wed blocked; warning that the essay does not fit",
    "cause": "Busy days were read one comma-separated piece at a time; \"Tuesday\" alone had no \"busy\" word.",
    "fix": "918eafb: a busy/hours rule carries over a following list of day names",
    "test": "tests/test_parser.py::test_busy_and_study_time_carry_over_a_list_of_days",
    "actual_before": "blocked days [0]",
    "actual_after": "blocked days [0, 1, 2]"
   },
   {
    "id": "BUG-02",
    "title": "Casual Vietnamese sentence read as one task; model never asked",
    "severity": "Medium",
    "found": "Manual check of the public site",
    "before": "4c77594",
    "after": "HEAD",
    "steps": "Send: \"Tuần này mình phải lo vụ lab hóa với cái slide nhóm môn kinh tế, cuối tuần nộp\"",
    "expected": "Two tasks (Lab hóa, Slide nhóm môn kinh tế) due this Sunday",
    "cause": "\"với\" did not split tasks, \"cuối tuần\" was not a deadline, and any rule match skipped the model.",
    "fix": "9ad5025: Vietnamese splitting and deadline words; long titles go to the model",
    "test": "tests/test_vietnamese.py::test_casual_vietnamese_shares_the_closing_deadline",
    "actual_before": "1 task(s): ['Tuần này mình phải lo vụ lab hóa với cái slide nhóm môn kinh tế']",
    "actual_after": "2 task(s): ['Lab hóa', 'Slide nhóm môn kinh tế']"
   },
   {
    "id": "BUG-03",
    "title": "Every request fails when the server runs without a console (pythonw)",
    "severity": "Critical",
    "found": "Deployment on the RTX PC (auto-start task)",
    "before": "4c77594",
    "after": "HEAD",
    "steps": "Start the server with pythonw.exe (sys.stdout/sys.stderr are None) and send any message",
    "expected": "HTTP 200",
    "cause": "http.server writes each request log line to sys.stderr, which is None under pythonw, so every handler crashed.",
    "fix": "e1c7996: send output to data/server.log when there is no console",
    "test": "eval/quality_eval.py bugs (BUG-03 probe)",
    "actual_before": "no response (connection closed)",
    "actual_after": "HTTP 200"
   },
   {
    "id": "BUG-04",
    "title": "Malformed Content-Length closes the connection without an answer",
    "severity": "Medium",
    "found": "Penetration test PT-05",
    "before": "c2a1ef5",
    "after": "HEAD",
    "steps": "POST /api/chat with header \"Content-Length: abc\"",
    "expected": "HTTP 400",
    "cause": "int() on the header raised ValueError outside any error handling.",
    "fix": "server.py: invalid Content-Length is treated as a bad request",
    "test": "tests/test_security.py::test_malformed_content_length_gets_400",
    "actual_before": "no response (connection closed)",
    "actual_after": "HTTP/1.0 400"
   },
   {
    "id": "BUG-05",
    "title": "Incomplete request body holds a server thread forever (slowloris)",
    "severity": "High",
    "found": "Penetration test PT-06",
    "before": "c2a1ef5",
    "after": "HEAD",
    "steps": "Declare Content-Length: 100, send 1 byte, keep the connection open",
    "expected": "Server gives up and closes the connection",
    "cause": "No socket timeout on the request handler, so the read blocks with no limit; many such connections exhaust threads.",
    "fix": "server.py: 15 s socket timeout on every connection",
    "test": "tests/test_security.py::test_slow_body_is_dropped",
    "actual_before": "still open after 25 s",
    "actual_after": "closed after 15 s"
   },
   {
    "id": "BUG-06",
    "title": "Server adopts a session id chosen by the client (session fixation)",
    "severity": "Medium",
    "found": "Penetration test PT-04",
    "before": "c2a1ef5",
    "after": "HEAD",
    "steps": "POST a message with a made-up 32-hex session_id that does not exist",
    "expected": "Server ignores it and issues its own random id",
    "cause": "Any well-formed id was used to create a new session.",
    "fix": "server.py: only ids that already exist are accepted",
    "test": "tests/test_security.py::test_unknown_session_id_is_replaced",
    "actual_before": "client id accepted",
    "actual_after": "new id issued"
   },
   {
    "id": "BUG-07",
    "title": "No browser security headers; Server header shows the Python version",
    "severity": "Low",
    "found": "Penetration test PT-11, PT-12",
    "before": "c2a1ef5",
    "after": "HEAD",
    "steps": "GET / and read the response headers",
    "expected": "X-Content-Type-Options, X-Frame-Options, Content-Security-Policy, Referrer-Policy; no version",
    "cause": "BaseHTTPRequestHandler defaults; no headers were added.",
    "fix": "server.py: security headers on every response, neutral Server header",
    "test": "tests/test_security.py::test_security_headers",
    "actual_before": "no security headers; Server: BaseHTTP Python/3.15.0",
    "actual_after": "nosniff/CSP present"
   }
