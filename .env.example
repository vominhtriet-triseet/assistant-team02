# Copy this file to .env to turn on the optional AI provider.
# Leave ASSISTANT_LLM empty to use only the rule-based assistant.

# Option 1: local model with Ollama (no API key, data stays on your machine)
# ASSISTANT_LLM=ollama
# ASSISTANT_LLM_MODEL=qwen2.5:3b
# OLLAMA_HOST=http://localhost:11434

# Option 2: any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Gemini, LM Studio, ...)
# ASSISTANT_LLM=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-key-here
# ASSISTANT_LLM_MODEL=the-model-name-your-provider-lists
ASSISTANT_LLM=
